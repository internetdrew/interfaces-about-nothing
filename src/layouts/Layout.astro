---
import "../styles/global.css";
import { title, description } from "../constants";

const siteUrl = "https://nothings.internetdrew.com/";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL("/og/site.png", siteUrl).href;
const ogImageAlt = `${title} ${description}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>

  <body class="px-4 max-w-xl mx-auto bg-stone-300">
    <nav class="py-6">
      <svg
        viewBox="0 0 96 48"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        font-size="16px"
        width="96"
        height="48"
        style="height: 14px; width: 28px; overflow: clip; flex-shrink: 0"
      >
        <circle
          cx="24"
          cy="24"
          r="24"
          font-size="16px"
          fill="#f7cc05"
          style="box-sizing: border-box; transform-origin: 0px 0px"
        />
        <circle
          cx="48"
          cy="24"
          r="24"
          font-size="16px"
          fill="#ee182d"
          style="box-sizing: border-box; transform-origin: 0px 0px"
        />
        <circle
          cx="72"
          cy="24"
          r="24"
          font-size="16px"
          fill="#1c4b9c"
          style="box-sizing: border-box; transform-origin: 0px 0px"
        />
      </svg>
    </nav>
    <header class="my-14">
      <h1 class="text-xl font-semibold title">{title}</h1>
      <p class="text-stone-600 font-[460] text-[15px] text-pretty">
        {description}
      </p>
    </header>
    <main class="root my-16">
      <slot />
    </main>
  </body>
</html>

<style>
  .root {
    isolation: isolate;
  }

  body {
    position: relative;
  }
</style>
