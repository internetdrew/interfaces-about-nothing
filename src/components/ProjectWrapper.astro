---
interface Props {
  name: string;
  description: string;
}

const { name, description } = Astro.props;
---

<section>
  <div class="flex items-center gap-1 mt-4">
    <span class="font-mono font-medium text-xs text-neutral-600 num">01</span>
    <h2 class="font-medium">{name}</h2>
  </div>
  <p class="text-neutral-600 text-sm">{description}</p>
  <div class="my-8">
    <slot />
  </div>
</section>
