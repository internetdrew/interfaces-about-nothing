---
import { ProjectNoteDialog } from "./ProjectNoteDialog";
interface Props {
  name: string;
  episodeName: string;
  season: number;
  episode: number;
}

const { name, episode, episodeName, season } = Astro.props;
---

<article>
  <header>
    <div class="flex items-center relative">
      <h2 class="title text-[17px] font-semibold">{name}</h2>
      {Astro.slots.has("note") && (
        <ProjectNoteDialog client:load title={name}>
          <slot name="note" />
        </ProjectNoteDialog>
      )}
    </div>
    <div class="text-stone-600 -mt-2.5 font-[460] flex flex-col">
      <small>
        Inspired by <em>{episodeName}</em>
      </small>
      <small>
        Season {season}, Episode {episode}
      </small>
    </div>
  </header>

  <div class="mt-8">
    <slot />
  </div>
</article>
